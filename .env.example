# ============================================================
# POTENCIAREDES — ENVIRONMENT CONFIGURATION
# ============================================================

# Server Port
PORT=3000
APP_URL="https://your-app-domain.run.app"

# Firebase Environment
# AI Studio injects credentials and firebase-applet-config.json automatically
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Initial Admin Emails (comma separated, granted ADMIN/SUPER_ADMIN access)
ADMIN_EMAILS="rodrigogalvez@42labs.cl"

# SystemFollows SMM Provider API v2
SYSTEMFOLLOWS_API_URL="https://systemfollows.com/api/v2"
SYSTEMFOLLOWS_API_KEY="YOUR_SYSTEMFOLLOWS_API_KEY"

# Pricing & Exchange Engine Defaults
DEFAULT_USD_CLP_RATE="950"
DEFAULT_GLOBAL_MARGIN_PERCENT="80"

# Transbank Webpay Plus & Webpay.cl Portal (Chile)
# Modes: PORTAL_CL (Portal Oficial Directo de Empresa) | REST_API (API REST Tradicional)
WEBPAY_MODE="PORTAL_CL"
WEBPAY_PORTAL_FORM_ID="436254"
WEBPAY_PORTAL_COMPANY_ID="186612"
WEBPAY_PORTAL_ACTION="https://www.webpay.cl/backpub/external/form-pay"
WEBPAY_ENVIRONMENT="PRODUCTION"
WEBPAY_COMMERCE_CODE="597055555532"
WEBPAY_API_KEY="579B532A7440BB06BE0A439E385D106B0"

# Mercado Pago Chile
MERCADOPAGO_ENVIRONMENT="TEST"
MERCADOPAGO_ACCESS_TOKEN="TEST-YOUR-MERCADOPAGO-ACCESS-TOKEN"
MERCADOPAGO_PUBLIC_KEY="TEST-YOUR-MERCADOPAGO-PUBLIC-KEY"
MERCADOPAGO_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"
